          ]
        }
      }
    },
    {
      "id": "system.memory-snapshot",
      "track": "system",
      "title": "看内存还剩多少（BSD 与 GNU 工具不同）",
      "goal": "打印当前内存使用概览：总量、已用、可用、缓存（只跑一条命令，不要进交互界面）",
      "hint": "Linux 用 free -h（-h 人类可读）；macOS 没有 free，用 vm_stat（页为单位，页大小通常 16K）或 top -l 1 | head",
      "sample": "vm_stat",
      "require": [
        {
          "p": "free|vm_stat|top",
          "tip": "Linux 用 free -h，macOS 用 vm_stat（或 top -l 1）"
        },
        {
          "p": "total|Pages|PhysMem|-h|-m",
          "tip": "要能看到总量与可用量"
        }
      ],
      "variants": {
        "linux": {
          "title": "内存概览（GNU）",
          "hint": "free -h 输出 total/used/free/buff-cache/available 一行看懂",
          "sample": "free -h",
          "require": [
            {
              "p": "\\bfree\\b",
              "tip": "Linux 上应使用 free"
            },
            {
              "p": "-h|--human|-m|-g",
              "tip": "应加人类可读或单位参数（-h / -m）"
            }
          ]
        },
        "darwin": {
          "title": "内存概览（macOS）",
          "hint": "macOS 用 vm_stat 看各页计数；想快速看一眼也可以 top -l 1 的 PhysMem 一行",
          "sample": "vm_stat",
          "require": [
            {
              "p": "vm_stat|top\\s+-l\\s*1",
              "tip": "macOS 上应使用 vm_stat（或 top -l 1）"
            }
          ]
        },
        "win32": {
          "sample": "Get-CimInstance Win32_OperatingSystem | Select-Object FreePhysicalMemory,TotalVisibleMemorySize",
          "require": [
            {
              "p": "Get-CimInstance\\s+Win32_OperatingSystem",
              "tip": "Windows 上用 Get-CimInstance 取内存信息"
            },
            {
              "p": "FreePhysicalMemory",
              "tip": "要看可用物理内存"
            },
            {
              "p": "TotalVisibleMemorySize",
              "tip": "也要看总内存"
            }
          ],
          "forbid": [
            {
              "p": "\\bfree\\s+-h\\b|vm_stat",
              "tip": "free / vm_stat 是 Linux 与 macOS 的命令",
              "severity": "warn"
            }
          ]
        }
      },
      "level": "medium"
    },
    {
      "id": "ops.file-owner-package",
      "track": "system",
      "title": "这个文件是哪个包装的（pkgutil 与 dpkg）",
      "goal": "查出某个已安装命令属于哪个软件包，判断它是包管理器装的还是手工拷进去的",
      "hint": "macOS 没有 dpkg，用 pkgutil --file-info 查文件归属；Linux 用 dpkg -S 反查包名。查不到往往说明是手工装的，升级时最容易踩",
      "require": [
        {
          "p": "pkgutil|dpkg|rpm",
          "tip": "应使用对应平台的包管理器反查"
        }
      ],
      "variants": {
        "darwin": {
          "sample": "pkgutil --file-info /usr/local/bin/terraform",
          "require": [
            {
              "p": "pkgutil\\s+--file-info",
              "tip": "macOS 应使用 pkgutil --file-info"
            },
            {
              "p": "/usr/local/bin/terraform",
              "tip": "应指定要查的文件路径"
            }
          ],
          "forbid": [
            {
              "p": "dpkg\\s+-S",
              "tip": "macOS 上没有 dpkg",
              "severity": "warn"
            }
          ]
        },
        "linux": {
          "sample": "dpkg -S /usr/bin/terraform",
          "require": [
            {
              "p": "dpkg\\s+-S",
              "tip": "Debian 系应使用 dpkg -S 反查包名"
            },
            {
              "p": "/usr/bin/terraform",
              "tip": "应指定要查的文件路径"
            }
          ],
          "forbid": [
            {
              "p": "pkgutil",
              "tip": "Linux 上没有 macOS 的 pkgutil",
              "severity": "warn"
            }
          ]
        }
      },
      "level": "medium",
      "platforms": [
        "darwin",
        "linux"
      ]
    },
    {
      "id": "system.load-per-cpu",
      "track": "system",
      "title": "负载高不高，先除以核数",
      "goal": "打印负载均值与可用核数，判断 1 分钟负载是否超过了核数",
      "hint": "load average 是\"可运行队列长度\"，4 核机器上 4.0 才刚跑满；不除以核数就说\"负载 8 好高\"会误判",
      "sample": "uptime && nproc",
      "require": [
        {
          "p": "uptime",
          "tip": "应使用 uptime 看负载"
        },
        {
          "p": "nproc|sysctl\\s+-n\\s+hw\\.ncpu",
          "tip": "还要拿到核数（Linux 用 nproc，macOS 用 sysctl -n hw.ncpu）"
        }
      ],
      "level": "easy"
    },
    {
      "id": "system.port-owner-forensics",
      "track": "system",
      "title": "端口被占了：从监听地址一路查到是哪个进程、跑了多久",
      "goal": "先列出占用该端口的监听项（不解析域名、不查服务名），再按 PID 查进程的父子关系与启动时长，最后给出确认要不要动它的依据",
      "hint": "lsof -nP 不去解析域名与端口名，输出稳定又快；拿到 PID 后 ps -o pid,ppid,etime,command 看它是不是被某个守护进程拉起来的、跑了多久",
      "sample": "lsof -nP -iTCP:8080 -sTCP:LISTEN && ps -o pid,ppid,etime,command -p $(lsof -tiTCP:8080 -sTCP:LISTEN)",
      "require": [
        {
          "p": "lsof -nP",
          "tip": "要加 -nP，避免解析域名与端口名拖慢输出"
        },
        {
          "p": "-iTCP:8080",
          "tip": "要指定被占的端口"
        },
        {
          "p": "-sTCP:LISTEN",
          "tip": "只看监听状态的连接"
        },
        {
          "p": "ps -o",
          "tip": "要查进程详情，不能只留 PID"
        },
        {
          "p": "ppid",
          "tip": "要带父进程，判断是不是被守护进程拉起来的"
        },
        {
          "p": "etime|start",
          "tip": "要带启动时长，判断它是老服务还是刚卡住的临时进程"
        },
        {
          "p": "lsof -tiTCP:8080",
          "tip": "取 PID 用 -t，避免把表头一起喂给 ps"
        }
      ],
      "level": "hard"
    }
  ]
}
