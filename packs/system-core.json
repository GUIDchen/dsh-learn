        {
          "p": "nproc|hw\\.ncpu|lscpu|cpuinfo",
          "tip": "要一起看 CPU 核数，负载单独看没意义"
        }
      ],
      "forbid": [],
      "level": "easy"
    },
    {
      "id": "system.process-top-mem",
      "track": "system",
      "title": "按内存占用排出前 10 个进程",
      "goal": "列出内存占用最高的 10 个进程（显示 PID、命令与内存占比），不做名字截断",
