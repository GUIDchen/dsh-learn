{
  "name": "dsh-learn",
  "version": "0.194.0",
  "private": true,
  "type": "module",
  "description": "跨平台命令行学习与验证工具（Linux / Docker）：核心评测逻辑与平台适配分离，CLI 与 Web 双客户端共用同一内核，macOS 优先。",
  "bin": {
    "cmdlearn": "./src/cli.mjs"
  },
  "scripts": {
    "cli": "node src/cli.mjs",
    "web": "node src/web/server.mjs",
    "test": "node --test",
    "agent": "node src/agent.mjs",
    "runners": "node src/cli.mjs runners",
    "verify": "bash scripts/verify.sh",
    "coverage": "node scripts/coverage.mjs",
    "coverage:update": "node scripts/coverage.mjs --update",
    "syntax": "bash scripts/check-syntax.sh",
    "release": "bash scripts/release-mac.sh",
    "release:adhoc": "bash scripts/release-mac.sh --ad-hoc",
    "lab": "bash scripts/lab.sh",
    "analyze": "node src/cli.mjs analyze",
    "modules": "node src/cli.mjs modules"
  },
  "engines": {
    "node": ">=18"
  }
}
