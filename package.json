{
  "name": "dsh-learn",
  "version": "0.207.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform practice-and-verify tool for command-line skills (ops/backend interviews): 637 graded tasks, platform variants, offline judge, shared by CLI, web and a native macOS app.",
  "bin": {
    "cmdlearn": "./src/cli.mjs"
  },
  "scripts": {
    "cli": "node src/cli.mjs",
    "web": "node src/web/server.mjs",
    "test": "node --test",
    "agent": "node src/agent.mjs",
    "runners": "node src/cli.mjs runners",
    "verify": "bash scripts/verify.sh",
    "coverage": "node scripts/coverage.mjs",
    "coverage:update": "node scripts/coverage.mjs --update",
    "syntax": "bash scripts/check-syntax.sh",
    "release": "bash scripts/release-mac.sh",
    "release:adhoc": "bash scripts/release-mac.sh --ad-hoc",
    "lab": "bash scripts/lab.sh",
    "analyze": "node src/cli.mjs analyze",
    "modules": "node src/cli.mjs modules"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GUIDchen/dsh-learn.git"
  },
  "homepage": "https://github.com/GUIDchen/dsh-learn",
  "bugs": {
    "url": "https://github.com/GUIDchen/dsh-learn/issues"
  }
}
